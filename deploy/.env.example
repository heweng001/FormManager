# 复制为项目根目录的 .env，或由 PM2 ecosystem 读取
# cp deploy/.env.example .env

NODE_ENV=production
PORT=3000

# 可选：默认 SMTP（个人未配置服务商时使用）
# SMTP_HOST=smtp.qiye.163.com
# SMTP_PORT=465

# 必改：随机长字符串（可用 openssl rand -hex 32 生成）
SESSION_SECRET=请替换为随机字符串

# 可选：服务器抓取 TikTok 邮箱时使用（国内服务器通常需要）
# TIKTOK_PROXY=http://127.0.0.1:7890
