# Nginx 反向代理示例
# 1. 将 erp.example.com 替换为你的域名
# 2. 复制到服务器: sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/form-manager
# 3. 启用: sudo ln -sf /etc/nginx/sites-available/form-manager /etc/nginx/sites-enabled/
# 4. 检查并重载: sudo nginx -t && sudo systemctl reload nginx
# 5. HTTPS: sudo apt install certbot python3-certbot-nginx && sudo certbot --nginx -d erp.example.com

server {
    listen 80;
    server_name erp.example.com;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
